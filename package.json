{
  "name": "wrtn-router-proxy",
  "version": "2.0.0",
  "private": true,
  "description": "Wrtn compatibility proxy for OpenCode and agent SDKs",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/proxy.mjs",
    "setup": "node scripts/setup-opencode.mjs",
    "opencode": "npm run setup && opencode",
    "stop": "node scripts/stop-proxy.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
