[Unit]
Description=Wrtn compatibility proxy for OpenCode and agent SDKs
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/wtrn-router
ExecStart=%h/.nvm/versions/node/v20.20.2/bin/node %h/wtrn-router/src/proxy.mjs
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
