{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "wrtn-chat": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Wrtn Router",
      "options": {
        "baseURL": "http://127.0.0.1:8788/v1"
      },
      "models": {
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8 (Wrtn Chat)",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" },
            "max": { "reasoningEffort": "max" }
          }
        },
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (Wrtn Chat)",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" }
          }
        },
        "claude-haiku-4-5-20251001": {
          "name": "Claude Haiku 4.5 (Wrtn Chat)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" }
          }
        },
        "gpt-5": {
          "name": "GPT-5 (Wrtn)",
          "limit": {
            "context": 400000,
            "output": 128000
          },
          "variants": {
            "none": { "reasoningEffort": "none" },
            "minimal": { "reasoningEffort": "minimal" },
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" }
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol (Wrtn)",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "variants": {
            "none": { "reasoningEffort": "none" },
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" },
            "max": { "reasoningEffort": "max" }
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra (Wrtn)",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "variants": {
            "none": { "reasoningEffort": "none" },
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" },
            "max": { "reasoningEffort": "max" }
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna (Wrtn)",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "variants": {
            "none": { "reasoningEffort": "none" },
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" },
            "max": { "reasoningEffort": "max" }
          }
        },
        "kimi-k3": {
          "name": "Kimi K3 (Wrtn)",
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        // 문서상 context는 1,048,576이지만 1.5MB(~786k tokens) 요청부터 상류가
        // 429를 반환한다(1MB까지는 정상). 재현되는 제약이라 500,000으로 제한한다.
        "glm-5.2": {
          "name": "GLM 5.2 (Wrtn)",
          "limit": {
            "context": 500000,
            "output": 131072
          }
        },
        "gpt-4.1-mini": {
          "name": "GPT-4.1 Mini (Wrtn)",
          "limit": {
            "context": 1047576,
            "output": 32768
          }
        }
      }
    }
  }
}
